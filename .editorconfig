# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{toml,yaml,yml,json,jsonc}]
indent_size = 2

[*.md]
# Trailing spaces are significant in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[LICENSE]
# Redistributed verbatim; never rewrite.
insert_final_newline = true
end_of_line = lf

[licenses/**]
end_of_line = lf
