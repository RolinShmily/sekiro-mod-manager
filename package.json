{
  "name": "sekiro-mod-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter sekiro-mod-manager-website dev",
    "build": "pnpm --filter sekiro-mod-manager-website build",
    "preview": "pnpm --filter sekiro-mod-manager-website preview",
    "test": "node --experimental-strip-types --test tests/worker/*.test.mjs tests/website/*.test.mjs",
    "lint": "pnpm --filter sekiro-mod-manager-website lint",
    "licenses:collect": "pnpm --filter sekiro-mod-manager-website licenses:collect"
  }
}
