{
  // CMake Tools is the driver: it runs vcvarsall for the selected kit, configures with the
  // preset, builds, and tells the debugger where the binary is.
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.configureOnEdit": false,

  // Point C/C++ IntelliSense at the compiler database the preset writes
  // (CMAKE_EXPORT_COMPILE_COMMANDS). Without it IntelliSense guesses its own include paths and
  // reports Qt and HuskarUI headers as not found.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/msvc-x64-debug/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",

  // Third-party sources are present but not ours to edit; keeping them out of search results and
  // diagnostics makes "find all references" and the Problems panel useful again.
  "files.associations": {
    "*.hpp": "cpp",
    "*.h": "cpp"
  },
  "search.exclude": {
    "build/**": true,
    "third_party/HuskarUI/**": true,
    "third_party/nlohmann/**": true,
    "third_party/miniz/**": true
  },
  "C_Cpp.files.exclude": {
    "third_party/HuskarUI/**": true,
    "third_party/miniz/**": true
  },

  // Applied to any launch that does not set it itself, so Qt's DLLs are found.
  "cmake.debugConfig": {
    "environment": [
      { "name": "PATH", "value": "C:/Qt/6.11.2/msvc2022_64/bin;${env:PATH}" },
      { "name": "QT_PLUGIN_PATH", "value": "C:/Qt/6.11.2/msvc2022_64/plugins" },
      { "name": "QML2_IMPORT_PATH", "value": "C:/Qt/6.11.2/msvc2022_64/qml" },
      { "name": "QML_IMPORT_PATH", "value": "C:/Qt/6.11.2/msvc2022_64/qml" }
    ]
  }
}
